#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&mo 4>;
        };

        td2: td2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD2";
            #binding-cells = <0>;
            bindings = <&shit RIGHT_SHIFT>, <&mo 0>;
        };

        shit: shit {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <50>;
        };

        question: question {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTION";
            bindings = <&kp LS(NUMBER_1)>, <&kp LS(MINUS)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        eins {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            timeout-ms = <100>;
        };

        zwei {
            bindings = <&kp TAB>;
            key-positions = <22 23>;
            timeout-ms = <100>;
        };

        drei {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            timeout-ms = <100>;
        };

        vier {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
            timeout-ms = <100>;
        };

        fuenf {
            bindings = <&mo 5>;
            key-positions = <33 36>;
            timeout-ms = <100>;
        };

        gaming {
            bindings = <&tog 6>;
            key-positions = <11 12 13 16 17 18>;
            timeout-ms = <100>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <7 8 6>;
        };

        tri {
            bindings = <&mo 3>;
            key-positions = <36 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
              &kp Q  &kp W  &kp F         &kp P          &kp B        &kp J            &kp L          &kp U      &kp Z    &kp AT
              &kp A  &kp R  &kp S         &kp T          &kp G        &kp M            &kp N          &kp E      &kp I    &kp O
&kp LEFT_GUI  &kp Y  &kp X  &kp C         &kp D          &kp V        &kp K            &kp H          &kp COMMA  &kp DOT  &kp SLASH  &question
                            &kp LEFT_ALT  &lt 3 K_EJECT  &kp SPACE    &kp RIGHT_SHIFT  &lt 1 K_EJECT  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
       &kp LESS_THAN     &kp NUMBER_7  &kp NUMBER_8   &kp N9        &kp RIGHT_BRACKET    &none  &none      &kp LEFT_BRACKET  &none         &none
       &kp GREATER_THAN  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp LS(NUMBER_7)     &none  &kp RSHFT  &kp RCTRL         &kp LEFT_ALT  &mo 2
&none  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp SLASH            &none  &none      &none             &none         &none  &none
                                       &kp BACKSLASH  &kp NUMBER_0  &kp SPACE            &none  &none      &none
            >;
        };

        layer_2 {
            bindings = <
       &kp F12  &kp F7  &kp F8         &kp F9   &none               &none   &none      &none      &none         &none
       &kp F11  &kp F4  &kp F5         &kp F6   &none               &none   &kp RSHFT  &kp RCTRL  &kp LEFT_ALT  &none
&none  &kp F10  &kp F1  &kp F2         &kp F3   &none               &none   &none      &none      &none         &none  &none
                        &kp SEMICOLON  &kp SQT  &kp LEFT_BRACKET    &tog 0  &none      &none
            >;
        };

        layer_3 {
            bindings = <
       &none  &none     &none      &none      &none    &kp LC(Y)  &kp LC(V)  &kp LC(C)      &kp LC(X)     &kp LC(Z)
       &mo 4  &kp LALT  &kp MINUS  &kp LSHFT  &none    &kp CLCK   &kp LEFT   &kp DOWN       &kp UP_ARROW  &kp RIGHT
&none  &none  &none     &none      &none      &none    &kp INS    &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &none
                        &none      &none      &none    &none      &none      &none
            >;
        };

        layer_4 {
            bindings = <
       &none  &none       &bt BT_CLR        &none       &kp C_MUTE         &kp LC(Y)       &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(Z)
       &none  &kp LALT    &kp LCTRL         &kp LSHFT   &kp C_VOLUME_UP    &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&none  &none  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_DN       &msc SCRL_DOWN  &none           &none           &none         &none            &none
                          &none             &none       &none              &mkp MB1        &mkp MB2        &mkp MB3
            >;
        };

        layer_5 {
            bindings = <
       &kp LS(NUMBER_6)  &kp BSLH          &kp RIGHT_BRACKET      &kp SLASH         &none        &kp GRAVE      &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &none           &kp LS(BACKSLASH)
       &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(RIGHT_BRACKET)  &kp LS(NUMBER_7)  &none        &kp LS(GRAVE)  &kp RA(NUMBER_7)  &kp RA(NUMBER_0)  &kp LS(COMMA)   &kp LS(NUMBER_2)
&none  &kp LS(N7)        &kp LS(NUMBER_1)  &kp LS(NUMBER_5)       &kp LS(NUMBER_0)  &none        &kp RA(Q)      &kp RA(NUMBER_8)  &kp RA(NUMBER_9)  &kp LS(PERIOD)  &kp HASH           &kp BACKSPACE
                                           &none                  &none             &kp SPACE    &kp ENTER      &none             &none
            >;
        };

        layer_6 {
            bindings = <
       &kp TAB    &kp Q  &kp W  &kp P     &kp R        &none   &none  &none  &none  &none
       &kp LSHFT  &kp A  &kp S  &kp D     &kp F        &none   &none  &none  &none  &none
&kp M  &kp LCTRL  &kp Z  &kp X  &kp C     &kp V        &none   &none  &none  &none  &none  &none
                         &kp B  &kp LALT  &kp SPACE    &tog 6  &none  &none
            >;
        };
    };
};
