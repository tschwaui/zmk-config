#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&mo 4>;
        };
    };

    combos {
        compatible = "zmk,combos";

        eins {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            timeout-ms = <100>;
        };

        zwei {
            bindings = <&kp TAB>;
            key-positions = <22 23>;
            timeout-ms = <100>;
        };

        drei {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            timeout-ms = <100>;
        };

        vier {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
            timeout-ms = <100>;
        };

        fuenf {
            bindings = <&mo 5>;
            key-positions = <34 35>;
            timeout-ms = <100>;
        };

        win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <32 37>;
            timeout-ms = <100>;
        };

        gaming {
            bindings = <&tog 6>;
            key-positions = <11 12 13 16 17 18>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
              &kp Q  &kp W  &kp F         &kp P  &kp B        &kp J            &kp L  &kp U      &kp Z    &kp AT
              &kp A  &kp R  &kp S         &kp T  &kp G        &kp M            &kp N  &kp E      &kp I    &kp O
&kp LEFT_GUI  &kp Y  &kp X  &kp C         &kp D  &kp V        &kp K            &kp H  &kp COMMA  &kp DOT  &kp SLASH  &tog 6
                            &kp LEFT_ALT  &td1   &kp SPACE    &kp RIGHT_SHIFT  &td0   &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
       &kp LESS_THAN     &kp NUMBER_7  &kp NUMBER_8          &kp N9        &kp RIGHT_BRACKET       &none  &none      &none      &none     &none
       &kp GREATER_THAN  &kp NUMBER_4  &kp NUMBER_5          &kp NUMBER_6  &kp NON_US_BACKSLASH    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &mo 2
&none  &kp TILDE         &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3  &kp MINUS               &none  &none      &none      &none     &none  &kp QUESTION
                                       &kp NON_US_BACKSLASH  &kp NUMBER_0  &kp SPACE               &none  &none      &none
            >;
        };

        layer_2 {
            bindings = <
                 &kp F12  &kp F7  &kp F8         &kp F9   &none               &none   &none      &none      &none     &none
                 &kp F11  &kp F4  &kp F5         &kp F6   &none               &none   &kp RSHFT  &kp RCTRL  &kp RALT  &none
&kp EXCLAMATION  &kp F10  &kp F1  &kp F2         &kp F3   &none               &none   &none      &none      &none     &none  &none
                                  &kp SEMICOLON  &kp SQT  &kp LEFT_BRACKET    &tog 0  &none      &none
            >;
        };

        layer_3 {
            bindings = <
       &none  &none     &none      &none      &none    &kp K_AGAIN  &kp K_PASTE  &kp K_PASTE    &kp K_CUT     &kp K_UNDO
       &mo 5  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp CLCK     &kp LEFT     &kp DOWN       &kp UP_ARROW  &kp RIGHT
&none  &none  &none     &none      &none      &none    &kp INS      &kp HOME     &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &none
                        &none      &none      &none    &none        &none        &none
            >;
        };

        layer_4 {
            bindings = <
       &none     &none     &bt BT_CLR  &none      &none    &kp K_AGAIN     &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
       &kp LALT  &kp LALT  &kp LCTRL   &kp LSHFT  &none    &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&none  &none     &none     &none       &none      &none    &msc SCRL_DOWN  &none           &none           &none         &none            &kp QUESTION
                           &none       &none      &none    &mkp MB1        &mkp MB2        &mkp MB3
            >;
        };

        layer_5 {
            bindings = <
       &kp LS(NUMBER_6)  &kp BSLH          &kp PLUS          &kp MINUS         &none        &kp BSLH                  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &none           &none
       &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp ASTERISK      &kp SLASH         &none        &kp LS(NON_US_BACKSLASH)  &kp RA(NUMBER_7)  &kp RA(NUMBER_0)  &kp LS(COMMA)   &kp LS(NUMBER_2)
&none  &kp LS(N7)        &kp LS(NUMBER_1)  &kp LS(NUMBER_5)  &kp LS(NUMBER_0)  &none        &kp RA(Q)                 &kp RA(NUMBER_8)  &kp RA(NUMBER_9)  &kp LS(PERIOD)  &kp HASH          &none
                                           &none             &none             &kp SPACE    &kp ENTER                 &kp BSPC          &none
            >;
        };

        layer_6 {
            bindings = <
       &kp TAB    &kp Q  &kp W  &kp P     &kp R        &none   &none  &none  &none  &none
       &kp LSHFT  &kp A  &kp S  &kp D     &kp F        &none   &none  &none  &none  &none
&kp M  &kp LCTRL  &kp Z  &kp X  &kp C     &kp V        &none   &none  &none  &none  &none  &none
                         &kp B  &kp LALT  &kp SPACE    &tog 6  &none  &none
            >;
        };
    };
};

# Default config
CONFIG_ZMK_KEYBOARD_NAME="Totem"
CONFIG_BT_MAX_CONN=2
CONFIG_BT_MAX_PAIRED=3

# ---- Low Latency BLE ----
CONFIG_ZMK_STUDIO=y
CONFIG_ZMK_SPLIT=y
CONFIG_BT_PERIPHERAL_PREF_MIN_CONN_INTERVAL=6   # 7.5 ms
CONFIG_BT_PERIPHERAL_PREF_MAX_CONN_INTERVAL=9   # 11.25 ms
CONFIG_BT_PERIPHERAL_PREF_SLAVE_LATENCY=0
CONFIG_BT_PERIPHERAL_PREF_TIMEOUT=400
CONFIG_BT_HID_INTERRUPT_PRIORITY=2

