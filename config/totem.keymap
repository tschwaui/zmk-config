#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 0>;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&mo 0>, <&mo 0>;
        };

        td2: td2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD2";
            #binding-cells = <0>;
            bindings = <&shit RIGHT_SHIFT>, <&mo 0>;
        };

        shit: shit {
            compatible = "zmk,behavior-sticky-key";
            label = "SHIT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <50>;
        };

        question: question {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTION";
            bindings = <&kp LS(NUMBER_1)>, <&kp LS(MINUS)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        eins {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            timeout-ms = <100>;
        };

        zwei {
            bindings = <&kp TAB>;
            key-positions = <22 23>;
            timeout-ms = <100>;
        };

        drei {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            timeout-ms = <100>;
        };

        vier {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
            timeout-ms = <100>;
        };

        fuenf {
            bindings = <&mo 0>;
            key-positions = <33 36>;
            timeout-ms = <100>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <7 8 6>;
        };

        tri {
            bindings = <&mo 0>;
            key-positions = <36 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
              &kp Q             &kp W  &kp F         &kp P  &kp B        &kp J            &kp L  &mt LEFT_BRACE U  &kp Z    &mt RA(MINUS) MINUS
              &mt APOSTROPHE A  &kp R  &kp S         &kp T  &kp G        &kp M            &kp N  &kp E             &kp I    &mt SEMICOLON SEMICOLON
&kp LEFT_GUI  &kp Y             &kp X  &kp C         &kp D  &kp V        &kp K            &kp H  &kp COMMA         &kp DOT  &kp SLASH                &mt LS(NUMBER_1) MINUS
                                       &kp LEFT_ALT  &mo 2  &kp SPACE    &kp RIGHT_SHIFT  &mo 1  &kp RCTRL
            >;
        };

        pfeile {
            bindings = <
           &kp GRAVE      &kp PRINTSCREEN      &kp SCROLLLOCK  &kp PAUSE_BREAK         &kp C_MUTE           &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(Z)
           &kp LEFT_WIN   &mt LEFT_ALT INSERT  &mt LCTRL HOME  &mt LEFT_SHIFT PAGE_UP  &kp C_VOLUME_UP      &kp        &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT
&kp POUND  &kp BACKSLASH  &kp DEL              &kp END         &kp PAGE_DOWN           &kp C_VOLUME_DOWN    &mkp MB1   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB2
                                               &mkp MB3        &mkp MB2                &mkp MB1             &kp        &kp             &kp
            >;
        };

        zahlen {
            bindings = <
              &kp LS(N1)       &kp LS(N2)       &kp LS(N3)       &kp LS(N4)       &kp LS(N5)         &kp LS(N6)       &kp LS(N7)       &kp LS(N8)       &kp LS(N9)       &kp LS(N0)
              &mt F1 NUMBER_1  &mt F2 NUMBER_2  &mt F3 NUMBER_3  &mt F4 NUMBER_4  &mt F5 NUMBER_5    &mt F6 NUMBER_6  &mt F7 NUMBER_7  &mt F8 NUMBER_8  &mt F9 NUMBER_9  &mt F10 NUMBER_0
&mt F12 HASH  &kp RA(N1)       &kp RA(N2)       &kp RA(N3)       &kp RA(N4)       &kp RA(N5)         &kp RA(N6)       &kp RA(N7)       &kp RA(N8)       &kp RA(N9)       &kp RA(N0)        &mt F11 RIGHT_BRACKET
                                                &kp LEFT_ALT     &kp LEFT_WIN     &kp LCTRL          &none            &none            &none
            >;
        };
    };
};
