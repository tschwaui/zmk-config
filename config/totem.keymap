#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        eins {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            timeout-ms = <75>;
        };

        zwei {
            bindings = <&kp TAB>;
            key-positions = <22 23>;
            timeout-ms = <75>;
        };

        drei {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            timeout-ms = <75>;
        };

        vier {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
            timeout-ms = <75>;
        };

        fuenf {
            bindings = <&mo 5>;
            key-positions = <34 35>;
        };

        layer4 {
            bindings = <&tog 4>;
            key-positions = <11 12 13>;
        };

        layer3 {
            bindings = <&tog 2>;
            key-positions = <16 17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
              &kp Q  &kp W  &kp F         &kp P  &kp B        &kp J      &kp L  &kp U      &kp Z    &kp AT
              &kp A  &kp R  &kp S         &kp T  &kp G        &kp M      &kp N  &kp E      &kp I    &kp O
&kp LEFT_GUI  &kp Y  &kp X  &kp C         &kp D  &kp V        &kp K      &kp H  &kp COMMA  &kp DOT  &kp SLASH  &kp LS(NUMBER_1)
                            &kp LEFT_ALT  &mo 3  &kp SPACE    &kp LSHFT  &mo 1  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
       &kp LESS_THAN     &kp NUMBER_7  &kp NUMBER_8          &kp N9        &kp RIGHT_BRACKET       &none  &none      &none      &none     &none
       &kp GREATER_THAN  &kp NUMBER_4  &kp NUMBER_5          &kp NUMBER_6  &kp NON_US_BACKSLASH    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &mo 2
&none  &kp TILDE         &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3  &kp MINUS               &none  &none      &none      &none     &none  &kp QUESTION
                                       &kp NON_US_BACKSLASH  &kp NUMBER_0  &kp SPACE               &none  &trans     &none
            >;
        };

        layer_2 {
            bindings = <
           &kp F12  &kp F7  &kp F8         &kp F9   &kp RIGHT_BRACKET       &none   &none      &none      &none     &none
           &kp F11  &kp F4  &kp F5         &kp F6   &kp NON_US_BACKSLASH    &none   &kp RSHFT  &kp RCTRL  &kp RALT  &none
&kp MINUS  &kp F10  &kp F1  &kp F2         &kp F3   &kp MINUS               &none   &none      &none      &none     &none  &none
                            &kp SEMICOLON  &kp SQT  &kp LEFT_BRACKET        &tog 0  &none      &none
            >;
        };

        layer_3 {
            bindings = <
       &none  &none     &none      &none      &none    &kp K_AGAIN  &kp K_PASTE  &kp K_PASTE    &kp K_CUT     &kp K_UNDO
       &mo 4  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp CLCK     &kp LEFT     &kp DOWN       &kp UP_ARROW  &kp RIGHT
&none  &none  &none     &none      &none      &none    &kp INS      &kp HOME     &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &none
                        &none      &none      &none    &none        &none        &none
            >;
        };

        layer_4 {
            bindings = <
        &trans    &trans    &bt BT_CLR  &trans     &trans    &kp K_AGAIN     &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
        &kp LALT  &kp LALT  &kp LCTRL   &kp LSHFT  &trans    &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans  &trans    &trans    &trans      &trans     &trans    &msc SCRL_DOWN  &trans          &trans          &trans        &trans           &trans
                            &trans      &trans     &tog 0    &mkp MB1        &mkp MB2        &mkp MB3
            >;
        };

        layer_5 {
            bindings = <
       &kp LS(NUMBER_6)  &kp BSLH          &kp PLUS          &kp MINUS         &none        &kp BSLH                  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &none           &none
       &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp ASTERISK      &kp SLASH         &none        &kp LS(NON_US_BACKSLASH)  &kp RA(NUMBER_7)  &kp RA(NUMBER_0)  &kp LS(COMMA)   &kp LS(NUMBER_2)
&none  &kp LS(N7)        &kp LS(NUMBER_1)  &kp LS(NUMBER_5)  &kp LS(NUMBER_0)  &none        &kp RA(Q)                 &kp RA(NUMBER_8)  &kp RA(NUMBER_9)  &kp LS(PERIOD)  &kp HASH          &none
                                           &none             &none             &kp SPACE    &kp ENTER                 &kp BSPC          &none
            >;
        };
    };
};
